{% assign editorial_base = '' %}
{% if page.home_preview %}{% assign editorial_base = '/preview' %}{% endif %}
<header>
  <nav id="navbar" class="navbar navbar-light navbar-expand-lg {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" aria-label="Main navigation" data-editorial-nav>
    <div class="container">
      <a class="navbar-brand title" href="{{ editorial_base | append: '/' | relative_url }}"><strong>Juntong</strong> Peng</a>
      <button class="navbar-toggler collapsed ml-auto" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="icon-bar top-bar"></span><span class="icon-bar middle-bar"></span><span class="icon-bar bottom-bar"></span>
      </button>
      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto">
          {% assign preview_routes = '/,/publications/,/teaching/,/cv/,/news/' | split: ',' %}
          {% assign preview_labels = 'About,Publications,Service & Teaching,CV,News' | split: ',' %}
          {% for suffix in preview_routes %}
            {% assign route = editorial_base | append: suffix %}
            <li class="nav-item{% if page.url == route %} active{% endif %}">
              <a class="nav-link" href="{{ route | relative_url }}"{% if page.url == route %} aria-current="page"{% endif %}>{{ preview_labels[forloop.index0] }}</a>
            </li>
          {% endfor %}
          {% if site.search_enabled %}
            <li class="nav-item"><button id="search-toggle" title="Search" aria-label="Search" onclick="openSearchModal()"><span class="nav-link"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></span></button></li>
          {% endif %}
          {% if site.enable_darkmode %}
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme" aria-label="Change theme">
                <i class="fa-half-sun-moon" id="light-toggle-system"></i>
                <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
                <i class="fa-solid fa-sun" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <progress id="progress" value="0"><div class="progress-container"><span class="progress-bar"></span></div></progress>
  {% endif %}
</header>
